# ---------------------------------------------------------------------------
# FoodCycle — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development via Docker:
#   docker run -d --name foodcycle-pg \
#     -e POSTGRES_USER=foodcycle -e POSTGRES_PASSWORD=foodcycle \
#     -e POSTGRES_DB=foodcycle -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://foodcycle:foodcycle@localhost:5432/foodcycle?schema=public"

# Auth.js (NextAuth) session signing secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of the app. Required in production; helpful in development so that
# OAuth/callback URLs and absolute links resolve correctly.
AUTH_URL="http://localhost:3000"

# Trust the host header. Set to "true" when deploying behind a proxy or to a
# platform such as Vercel/Fly that terminates TLS in front of the app.
AUTH_TRUST_HOST="true"
